#include <iostream>
#include <stdexcept>
#include <string>

// Custom exception for stack overflow
class StackOverflowException : public std::exception {
public:
    const char* what() const noexcept override {
        return "StackOverflowException - Stack is full!";
    }
};

// Custom exception for stack underflow
class StackUnderflowException : public std::exception {
public:
    const char* what() const noexcept override {
        return "StackUnderflowException - Stack is empty!";
    }
};

// Template class for Stack with fixed capacity
template <typename T, size_t Capacity = 10>
class Stack {
private:
    T data[Capacity];
    size_t topIndex;
    
public:
    Stack() : topIndex(0) {}
    
    void push(const T& value) {
        if (topIndex >= Capacity) {
            throw StackOverflowException();
        }
        data[topIndex++] = value;
    }
    
    T pop() {
        if (topIndex == 0) {
            throw StackUnderflowException();
        }
        return data[--topIndex];
    }
    
    bool isEmpty() const {
        return topIndex == 0;
    }
    
    bool isFull() const {
        return topIndex == Capacity;
    }
};

int main() {
    try {
        Stack<int, 3> stack; // Small stack for demonstration
        
        // Demonstrate pushing to a full stack
        stack.push(1);
        stack.push(2);
        stack.push(3);
        std::cout << "Pushed 3 items successfully." << std::endl;
        
        try {
            stack.push(4); // This should throw StackOverflowException
        }
        catch (const StackOverflowException& e) {
            std::cout << "Pushing to a full stack: " << e.what() << std::endl;
        }
        
        // Demonstrate popping from an empty stack
        while (!stack.isEmpty()) {
            stack.pop();
        }
        std::cout << "Popped all items successfully." << std::endl;
        
        try {
            stack.pop(); // This should throw StackUnderflowException
        }
        catch (const StackUnderflowException& e) {
            std::cout << "Popping from an empty stack: " << e.what() << std::endl;
        }
    }
    catch (const std::exception& e) {
        std::cerr << "Unexpected error: " << e.what() << std::endl;
    }
    
    return 0} 







