#include <iostream>
#include <stdexcept>
#include <string>

// Task 01 exception
class InvalidValueException : public std::exception {
public:
    const char* what() const noexcept override {
        return "InvalidValueException - Value is out of acceptable range.";
    }
};

// Task 02 exceptions
class StackOverflowException : public std::exception {
public:
    const char* what() const noexcept override {
        return "StackOverflowException - Stack is full!";
    }
};

class StackUnderflowException : public std::exception {
public:
    const char* what() const noexcept override {
        return "StackUnderflowException - Stack is empty!";
    }
};

// Validated Stack that checks values before pushing
template <typename T, size_t Capacity = 10>
class ValidatedStack {
private:
    T data[Capacity];
    size_t topIndex;
    T minValue;
    T maxValue;
    
public:
    ValidatedStack(T min, T max) : topIndex(0), minValue(min), maxValue(max) {}
    
    void push(const T& value) {
        if (topIndex >= Capacity) {
            throw StackOverflowException();
        }
        if (value < minValue || value > maxValue) {
            throw InvalidValueException();
        }
        data[topIndex++] = value;
    }
    
    T pop() {
        if (topIndex == 0) {
            throw StackUnderflowException();
        }
        return data[--topIndex];
    }
    
    bool isEmpty() const {
        return topIndex == 0;
    }
    
    bool isFull() const {
        return topIndex == Capacity;
    }
};

int main() {
    try {
        // Create a stack that only accepts ages between 0 and 120
        ValidatedStack<int, 3> ageStack(0, 120);
        
        // Try pushing valid age
        ageStack.push(25);
        std::cout << "Pushed valid age 25" << std::endl;
        
        // Try pushing invalid age
        try {
            ageStack.push(-5);
        }
        catch (const InvalidValueException& e) {
            std::cout << "Error: " << e.what() << std::endl;
        }
        
        // Fill the stack
        ageStack.push(30);
        ageStack.push(40);
        
        // Try pushing to full stack
        try {
            ageStack.push(50);
        }
        catch (const StackOverflowException& e) {
            std::cout << "Error: " << e.what() << std::endl;
        }
        
        // Empty the stack
        while (!ageStack.isEmpty()) {
            std::cout << "Popped age: " << ageStack.pop() << std::endl;
        }
        
        // Try popping from empty stack
        try {
            ageStack.pop();
        }
        catch (const StackUnderflowException& e) {
            std::cout << "Error: " << e.what() << std::endl;
        }
    }
    catch (const std::exception& e) {
        std::cerr << "Unexpected error: " << e.what() << std::endl;
    }
    
    return 0;
}